# Local Express API listener. Vite proxies browser /api requests to this service.
API_PORT=4000
API_HOST=0.0.0.0
NODE_ENV=development

# Optional until a Supabase project is configured. URL and publishable key are a required pair.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only: used by administrator-guarded Auth invitations and initial profile creation.
# Never add a VITE_ prefix, commit a value, return it from an API, or log it.
SUPABASE_SECRET_KEY=

# Exact callback must also be allowlisted in Supabase Auth.
SUPABASE_INVITE_REDIRECT_URL=http://localhost:3000/staff/accept-invite
